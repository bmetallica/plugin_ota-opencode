# Wird von ./setup.sh als .env angelegt. Nie ins Git.
GEDAECHTNIS_DB_PW=
# Damit koppelt OTA (Einstellungen → Erweiterungen → Hinzufügen).
GEDAECHTNIS_KOPPLUNGSSCHLUESSEL=
# Uhrzeit der nächtlichen Pflege (Ablauf, Nachholen der Embeddings).
GEDAECHTNIS_PFLEGE_UHRZEIT=03:30
# Internes Netz von Dienst und Datenbank. Nur ändern, wenn es sich mit
# einem anderen Netz auf dem Host überschneidet.
GEDAECHTNIS_NETZ=10.98.254.0/28
# Ort der Datenbank. Leer: das Docker-Volume ota_gedaechtnis_daten. Nicht von
# Hand umstellen — `sudo scripts/daten-umziehen.sh --gedaechtnis <Pfad>` in
# OTA zieht die Daten um und trägt den Pfad hier ein (OTA-Handbuch, Kapitel 40).
GEDAECHTNIS_DB_DIR=
# Firmenproxy für den Bau des Images, leer: keiner.
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=
